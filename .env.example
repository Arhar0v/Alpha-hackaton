# ==========================================
# Обязательные секретные ключи
# ==========================================
TG_BOT_TOKEN=your_telegram_bot_token_here
GROQ_API_KEY=your_groq_api_key_here
DB_PASSWORD=your_db_password_here

# ==========================================
# Настройки базы данных
# ==========================================
# ВАЖНО: При запуске через docker compose (как указано в README), 
# DB_HOST и DB_NAME уже настроены в docker-compose.yml.
# Эти переменные нужны только в том случае, если вы запускаете код ЛОКАЛЬНО без Docker.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=alfa_course_hackathon
DB_USER=postgres